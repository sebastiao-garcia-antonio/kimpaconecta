# =======================================================
# KIMPA CONNECT — AMBIENTE PRODUÇÃO
# =======================================================
# Copiar para .env no servidor e preencher os valores reais

# 1. BASE DE DADOS POSTGRESQL (Neon ou VPS)
DATABASE_URL="postgresql://neondb_owner:SENHA@ep-xxx.neon.tech/neondb?sslmode=require&channel_binding=require"

# 2. NEXTAUTH
AUTH_SECRET="gerar_com_openssl_rand_hex_32"
NEXTAUTH_URL="https://kimpaconnect.ukv.ao"

# 3. SOCKET.IO / PORTA
PORT=3000
NODE_ENV="production"
NEXT_PUBLIC_SOCKET_URL="https://kimpaconnect.ukv.ao"

# 4. UPLOADS
UPLOAD_DIR="./public/uploads"

# 5. EMAIL SMTP (opcional)
SMTP_HOST="smtp.exemplo.com"
SMTP_PORT="587"
SMTP_USER="utilizador@exemplo.com"
SMTP_PASSWORD="senha-do-smtp"
EMAIL_FROM="Kimpa Connect <no-reply@exemplo.com>"
